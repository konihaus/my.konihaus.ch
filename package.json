{
  "name": "my-konihaus-ch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Konihaus customer portal (my.konihaus.ch): login, setup, subscription, support messages. Express + S3 JSON.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env index.js",
    "start": "node index.js",
    "sync": "node --env-file=.env scripts/sync.js",
    "threads": "node --env-file=.env scripts/threads.js",
    "reply": "node --env-file=.env scripts/reply.js",
    "create-bucket": "node --env-file=.env scripts/create-bucket.js",
    "s3check": "node --env-file=.env scripts/s3-check.js",
    "test": "node --test test/portal.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/functions": "^2.0.0",
    "express": "^4.21.0"
  }
}
