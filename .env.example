# Public URL of the portal (used for magic links and Origin checks)
BASE_URL=https://my.konihaus.ch

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Object storage: Safe Swiss Cloud (S3-compatible), same account and keys as the konihaus.ch dashboard.
# A bucket dedicated to the portal is cleaner (konihaus-portal); until it exists the portal can share konihaus-data
# (the portal only uses the prefixes index/ and customers/).
S3_ENDPOINT=https://s3.ewstorage.ch
S3_REGION=ch-zh1
S3_BUCKET=konihaus-portal
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For AWS instead: leave S3_ENDPOINT / S3_ACCESS_KEY_ID empty and use AWS_ROLE_ARN (OIDC) below.

# Only if you use AWS instead of Safe Swiss Cloud. In Vercel prefer OIDC: set only AWS_ROLE_ARN.
AWS_ROLE_ARN=
# Local development / fallback only (long-lived keys, avoid in production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (Resend REST API). Without RESEND_API_KEY, emails are printed to the log (dev mode).
RESEND_API_KEY=
MAIL_FROM=Konihaus <portal@konihaus.ch>
# Where you get notified about new customer messages
ADMIN_EMAIL=
